# Copy to .env for local runs. NO SECRETS GO IN HERE.
# The Gemini API key is not an env var — it lives in Secret Manager (see lib/secrets.js).

# App Check rollout: monitor (log only) -> enforce (reject unattested clients) -> off (local only)
APPCHECK_MODE=monitor

# Extra origins allowed to call /api. Empty = same-origin only, which is the deployed default.
ALLOWED_ORIGINS=

# Required locally only; on Cloud Run the project id comes from the metadata server.
# GOOGLE_CLOUD_PROJECT=your-project-id

# Set by the deploy command — used to verify the Cloud Scheduler OIDC token on /jobs/owlpost.
# SCHEDULER_SA=diary-scheduler@your-project-id.iam.gserviceaccount.com
# JOB_AUDIENCE=https://your-service-xxxxx.a.run.app/jobs/owlpost

# Optional model overrides
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_SECRET_NAME=GEMINI_API_KEY
