{
  "name": "the-answering-diary",
  "version": "1.0.0",
  "description": "An authenticated AI journal on Cloud Run \u2014 Firebase Auth, Firestore, Gemini, Secret Manager",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "node --check server.js && node --check lib/gemini.js && node --check lib/journal.js && node --check lib/secrets.js && node --check lib/appcheck.js",
    "test": "node --experimental-test-module-mocks --test test/fallback.test.mjs test/chain-parse.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project answering-diary-rules-test \"node --test test/rules.test.mjs\""
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.0.0",
    "@google/genai": "^1.9.0",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.0",
    "google-auth-library": "^9.15.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.18.0"
  }
}
